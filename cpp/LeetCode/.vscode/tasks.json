{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-15 build active file",
            "command": "/opt/homebrew/Cellar/gcc/15.1.0/bin/g++-15",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "--std=c++23",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/program"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
						"presentation": {
							"echo": true,
							"reveal": "silent",
							"focus": false,
							"panel": "shared",
							"showReuseMessage": true,
							"clear": true
						},
            "detail": "Task generated by Debugger."
        },
				{
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "clang++",
            "args": [
                "-fdiagnostics-color=always",
								"-Wno-overriding-deployment-version",
                "-g",
                "--std=c++23",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/program"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
						"presentation": {
							"echo": true,
							"reveal": "silent",
							"focus": false,
							"panel": "shared",
							"showReuseMessage": true,
							"clear": true
						},
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}