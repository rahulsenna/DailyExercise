{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "g++-15 activeFile",
      "command": "/opt/homebrew/Cellar/gcc/15.1.0/bin/g++-15",
      "args": [
        "-fdiagnostics-color=always",
        "-g3",
        "-O0",
        "--std=c++23",
        "${file}",
        "-o",
        "${workspaceFolder}/bin/program"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}