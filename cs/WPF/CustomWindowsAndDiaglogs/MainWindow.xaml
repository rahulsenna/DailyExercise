<Window x:Class="CustomWindowsAndDiaglogs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomWindowsAndDiaglogs"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel >
            <Button Name="btnNormal" Click="btnNormal_Click" Width="100" Height="40" Content="Normal" Margin="5" />
            <Button Name="btnModal" Click="btnModal_Click" Width="100" Height="40" Content="Modal" Margin="5" />
            <TextBox Name="txtInput" Width="200" Height="40" FontSize="20" Margin="5" />
        </StackPanel>

    </Grid>
</Window>
